# ============================================================================
# Gaming Event Processing - Environment Configuration
# ============================================================================
# This file contains all configurable environment variables for the gaming
# event processing system. Copy this file to .env and update with your values.

# ============================================================================
# KAFKA CONFIGURATION
# ============================================================================
# Kafka broker connection settings

# Bootstrap servers (comma-separated list)
# Use 'localhost:29092' for host access, 'kafka:9092' for inter-container
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Topic names for event streams
INIT_TOPIC=init_events
MATCH_TOPIC=match_events
PURCHASE_TOPIC=purchase_events
KAFKA_SILVER_TOPIC=silver_events

# Kafka producer settings
KAFKA_ACKS=all
KAFKA_RETRIES=3
KAFKA_COMPRESSION_TYPE=none

# ============================================================================
# EVENT PRODUCER CONFIGURATION
# ============================================================================
# Settings for the event generator/producer

# Event generation rate
EVENT_RATE_PER_SECOND=100
BATCH_SIZE=10

# Event type probabilities (relative weights, will be normalized)
INIT_PROBABILITY=0.3
MATCH_PROBABILITY=0.5
PURCHASE_PROBABILITY=0.2

# Simulation settings
USERS_POOL_SIZE=1000

# Schema directory (relative to project root)
SCHEMA_DIR=schemas

# ============================================================================
# STORAGE PATHS - BRONZE LAYER
# ============================================================================
# Delta Lake storage paths for bronze (raw) data

STORAGE_BASE_PATH=/opt/bitnami/spark/storage
STORAGE_BRONZE_PATH=/opt/bitnami/spark/storage/bronze/events

# Bronze ingestion settings
KAFKA_STARTING_OFFSETS=earliest
STREAMING_MAX_OFFSETS_PER_TRIGGER=10000

# ============================================================================
# STORAGE PATHS - SILVER LAYER
# ============================================================================
# Delta Lake storage paths for silver (cleaned/transformed) data

STORAGE_SILVER_INIT_PATH=/opt/bitnami/spark/storage/silver/init
STORAGE_SILVER_MATCH_PATH=/opt/bitnami/spark/storage/silver/match
STORAGE_SILVER_PURCHASE_PATH=/opt/bitnami/spark/storage/silver/purchase

# ============================================================================
# STORAGE PATHS - GOLD LAYER
# ============================================================================
# Delta Lake storage paths for gold (aggregated) data

# Batch aggregations
STORAGE_GOLD_DAILY_USERS_PATH=/opt/bitnami/spark/storage/gold/daily_users

# Real-time aggregations
STORAGE_GOLD_MINUTE_PURCHASES_PATH=/opt/bitnami/spark/storage/gold/minute_purchases
STORAGE_GOLD_MINUTE_MATCHES_PATH=/opt/bitnami/spark/storage/gold/minute_matches
STORAGE_GOLD_MINUTE_PURCHASES_BY_COUNTRY_PATH=/opt/bitnami/spark/storage/gold/minute_purchases_by_country
STORAGE_GOLD_MINUTE_MATCHES_BY_COUNTRY_PATH=/opt/bitnami/spark/storage/gold/minute_matches_by_country

# ============================================================================
# CHECKPOINT LOCATIONS
# ============================================================================
# Structured Streaming checkpoint directories

# Bronze layer checkpoints
CHECKPOINT_BRONZE=/opt/bitnami/spark/storage/checkpoints/bronze_ingestion

# Silver layer checkpoints
CHECKPOINT_SILVER_INIT=/opt/bitnami/spark/storage/checkpoints/silver_init
CHECKPOINT_SILVER_MATCH=/opt/bitnami/spark/storage/checkpoints/silver_match
CHECKPOINT_SILVER_PURCHASE=/opt/bitnami/spark/storage/checkpoints/silver_purchase
CHECKPOINT_SILVER_INIT_KAFKA=/opt/bitnami/spark/storage/checkpoints/silver_init_kafka
CHECKPOINT_SILVER_MATCH_KAFKA=/opt/bitnami/spark/storage/checkpoints/silver_match_kafka
CHECKPOINT_SILVER_PURCHASE_KAFKA=/opt/bitnami/spark/storage/checkpoints/silver_purchase_kafka

# Gold layer checkpoints
CHECKPOINT_GOLD_PURCHASES=/opt/bitnami/spark/storage/checkpoints/gold_purchases
CHECKPOINT_GOLD_MATCHES=/opt/bitnami/spark/storage/checkpoints/gold_matches
CHECKPOINT_GOLD_PURCHASES_BY_COUNTRY=/opt/bitnami/spark/storage/checkpoints/gold_purchases_by_country
CHECKPOINT_GOLD_MATCHES_BY_COUNTRY=/opt/bitnami/spark/storage/checkpoints/gold_matches_by_country

# ============================================================================
# DATA QUALITY CONFIGURATION
# ============================================================================
# Settings for data quality transformations

# Transformation rule directories
RULES_DIR=/opt/bitnami/spark/jobs/src/data_quality/config/rules
EVENT_CONFIGS_PATH=/opt/bitnami/spark/jobs/src/data_quality/config/event_configs.yml

# Kafka output settings
ENABLE_KAFKA_OUTPUT=true

# ============================================================================
# STREAMING CONFIGURATION
# ============================================================================
# Spark Structured Streaming settings

# Trigger intervals
STREAMING_TRIGGER_INTERVAL=10 seconds
STREAMING_WATERMARK_DELAY=10 minutes

# Window duration for aggregations
WINDOW_DURATION=1 minute

# ============================================================================
# SPARK CONFIGURATION
# ============================================================================
# Spark application settings

# Application names (will be set by each job)
# SPARK_APP_NAME is set dynamically by each application

# Spark logging level (DEBUG, INFO, WARN, ERROR)
SPARK_LOG_LEVEL=WARN

# ============================================================================
# APPLICATION LOGGING
# ============================================================================
# Python application logging settings

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# VISUALIZER CONFIGURATION
# ============================================================================
# Settings for data visualization tool

# Number of sample rows to display
NUM_ROWS=10

# ============================================================================
# AWS CREDENTIALS (Optional)
# ============================================================================
# Required only if using S3 for storage instead of local filesystem

# AWS_ACCESS_KEY_ID=your_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here